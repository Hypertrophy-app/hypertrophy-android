CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# JWT verification key from Clerk Dashboard > API Keys > Show JWT public key
# (PEM Public Key section). loadClerkJwkFromPem strips newlines, so the whole
# PEM may be pasted on a single line: -----BEGIN PUBLIC KEY-----<body>-----END PUBLIC KEY-----
# Do NOT use literal \n separators -- they are not stripped and corrupt the key.
CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----replace_with_base64_body-----END PUBLIC KEY-----
CLERK_AUTHORIZED_PARTIES=http://localhost:8787
